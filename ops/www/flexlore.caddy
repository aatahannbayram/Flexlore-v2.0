# Installed as /opt/caddy/sites/flexlore.caddy on the shared VPS. flexlore.com is the canonical host (SITE.url, every page's
# <link rel="canonical">). www serves the same site WITHOUT redirecting: the old Framer site sent flexlore.com -> www with a
# permanent 308 that browsers remember, so a www -> apex redirect here loops for every returning visitor
# (ERR_TOO_MANY_REDIRECTS, seen 2026-11-14). Revisit a www -> apex 301 only after those cached redirects have aged out.
flexlore.com, www.flexlore.com {
	encode zstd gzip
	header {
		# Start HSTS short; raise to 31536000 after two calm weeks.
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Microphone stays allowed for this site only: the Flex AI voice assistant uses it after the visitor asks.
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}
	reverse_proxy flexlore-web:80
}

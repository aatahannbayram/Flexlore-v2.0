# Installed as /opt/caddy/sites/flexlore.caddy on the shared VPS. www.flexlore.com is the canonical host (SITE.url, every
# page's <link rel="canonical">), as on the old Framer site, so Search Console history and rankings carry on unchanged.
# The bare domain redirects to www, the same direction as Framer's old 308 that browsers remember (so no redirect loop).
www.flexlore.com {
	encode zstd gzip
	header {
		# Start HSTS short; raise to 31536000 after two calm weeks.
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Microphone stays allowed for this site only: the Flex AI voice assistant uses it after the visitor asks.
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}
	reverse_proxy flexlore-web:80
}

flexlore.com {
	redir https://www.flexlore.com{uri} permanent
}

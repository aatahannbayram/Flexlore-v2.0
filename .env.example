# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# ElevenLabs API key: only for scripts/elevenlabs-sync.mjs (agent push), never shipped to the browser.
# Create it with `npx -y @elevenlabs/cli@latest onboard init`, which writes it to .env.local for you.
ELEVENLABS_API_KEY=
# Public agent ID for the site assistant (not a secret; the agent only accepts allowlisted hosts). Unset = no assistant.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional analytics and error tracking (see components/Analytics.tsx). PostHog only loads after analytics consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
